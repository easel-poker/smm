{
  "manifest_version": 3,
  "name": "OneSMM Auto Register Loop",
  "version": "2.0",
  "description": "Native Extension for OneSMM Registration and Python Supervisor Bridge",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://api.telegram.org/*",
    "https://onesmm.com/*",
    "https://*.hcaptcha.com/*",
    "https://newassets.hcaptcha.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://onesmm.com/*",
        "https://*.hcaptcha.com/*",
        "https://newassets.hcaptcha.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
