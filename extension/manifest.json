{
  "manifest_version": 3,
  "name": "OneSMM Auto Loop Bot",
  "version": "3.0",
  "description": "OneSMM Registration Extension",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://onesmm.com/*",
        "*://*.onesmm.com/*",
        "*://*.hcaptcha.com/*",
        "*://newassets.hcaptcha.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
