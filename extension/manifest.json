{
  "manifest_version": 3,
  "name": "OneSMM Bot Extension",
  "version": "3.5",
  "description": "OneSMM Automation Extension",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onesmm.com/*",
        "http://onesmm.com/*",
        "https://*.onesmm.com/*",
        "https://*.hcaptcha.com/*",
        "https://newassets.hcaptcha.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ]
}
